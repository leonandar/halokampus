# ============================================================ haloK@MPUS — contoh konfigurasi
# Salin ke .env lalu ganti semua nilai bertanda GANTI. Jangan commit .env.

# ---------- Basis data & antrean
POSTGRES_PASSWORD=halokampus_dev
DATABASE_URL=postgresql://halokampus:halokampus_dev@localhost:5432/halokampus
REDIS_URL=redis://localhost:6379

# ---------- Kunci kriptografi (GANTI; buat dengan: openssl rand -base64 32)
# DATA_ENCRYPTION_KEY: AES-256-GCM untuk kolom sensitif. BLIND_INDEX_KEY: HMAC indeks buta.
# RESEARCH_PSEUDONYM_KEY: HMAC pseudonim stabil untuk ekspor penelitian (Fase 3).
DATA_ENCRYPTION_KEY=GANTI_base64_32_byte
BLIND_INDEX_KEY=GANTI_base64_32_byte
RESEARCH_PSEUDONYM_KEY=GANTI_base64_32_byte

# ---------- Layanan
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Origin yang boleh memanggil API dari peramban (widget tertanam di situs PMB juga dicantumkan di sini)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Proses pipeline AI di dalam proses API (true untuk pengembangan/uji) atau lewat worker BullMQ (false)
AI_INLINE=true
# Aktifkan simulator kanal (/sim/*). WAJIB false di produksi.
ENABLE_SIMULATORS=true
CONFIG_DIR=../../config

# ---------- Sistem PMB (mock pada penelitian; AS-01)
PMB_API_URL=http://localhost:4100
MOCK_PMB_PORT=4100

# ---------- Email (OTP & kanal email). Pengembangan memakai Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="haloK@MPUS <no-reply@halokampus.local>"
MAILPIT_API_URL=http://localhost:8025

# ---------- Penyedia LLM (FR-19). Urutan per agen diatur di parameter PRM-20.
# mock: deterministik, tanpa kunci. Selalu tersedia.
# anthropic (eksternal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# ollama (lokal) — jalankan: docker compose --profile local-llm up -d ollama; lalu: docker exec -it halokampus-ollama-1 ollama pull <model>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# openai_compatible (lokal: vLLM/LM Studio/llama.cpp; eksternal: OpenAI/Gemini). LOCATION=local|external
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_LOCATION=local

# ---------- Embedding (RAG). mock | ollama | openai_compatible
EMBEDDING_PROVIDER=mock
OLLAMA_EMBED_MODEL=
OPENAI_COMPAT_EMBED_MODEL=

# ---------- Kanal (Fase 2)
WHATSAPP_MODE=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---------- Seed DUMMY
SEED_DEFAULT_PASSWORD=GANTI_kata_sandi_awal_tanpa_tanda_pagar

# ---------- Kanal Fase 2. Mode "simulator" menulis ke sim_outbox (khusus pengembangan).
# Messenger & Instagram DM (Meta Graph API): simulator | graph
META_MODE=simulator
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Telegram Bot API: simulator | bot_api
TELEGRAM_MODE=simulator
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Email: simulator | smtp. Email masuk dikirim layanan inbound-parse/relay IMAP ke POST /webhooks/email
EMAIL_MODE=simulator
EMAIL_WEBHOOK_TOKEN=
# Socket.IO lewat Redis (wajib bila AI_INLINE=false agar notifikasi dari worker sampai ke konsol)
REALTIME_REDIS=false
